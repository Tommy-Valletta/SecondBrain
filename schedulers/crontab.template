# Run SecondBrain auto-ingest daemon every 10 minutes
*/10 * * * * /bin/bash -lc 'set -a; [[ -f "{{VAULT_PATH}}/brain.env" ]] && . "{{VAULT_PATH}}/brain.env"; set +a; exec "{{VAULT_PATH}}/.claude/scripts/auto-ingest.sh"' >> "{{VAULT_PATH}}/wiki/logs/auto-ingest-launchd.log" 2>> "{{VAULT_PATH}}/wiki/logs/auto-ingest-launchd-err.log"
