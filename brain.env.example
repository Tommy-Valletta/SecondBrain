# SecondBrain Environment Configuration
# Source this file or let launchd/cron load it automatically.

# Optional Pi model override; blank uses the configured agent default.
# Choose a model that returns plain Markdown for ingestion.
export INGEST_MODEL=""
export INGEST_FALLBACK_MODEL=""

# Optional model override for claude -p runs
export MODEL=""

# Path to lock directory (defaults to /tmp/brain-auto-ingest.lock)
export BRAIN_LOCK_DIR="/tmp/brain-auto-ingest.lock"

# Optional custom certificate authority file for your environment.
export BRAIN_CA_BUNDLE=""

# Optional space-separated environment variable names to omit from Claude calls.
export BRAIN_UNSET_ENV=""

# launchd job label (default: com.secondbrain.auto-ingest)
export BRAIN_LAUNCHD_LABEL="com.secondbrain.auto-ingest"

# Optional regex for synthetic session working directories (skipped during ingestion)
export BRAIN_SYNTHETIC_CWD_RE=""

# Optional path to secondary vault for recall search tier
export BRAIN_EXTRA_RECALL_DIR=""

# Maximum sessions to process per 10-minute auto-ingest cycle
export MAX_SESSIONS="5"
